{

  "name": "pss-nexus-chat-desktop",

  "version": "1.1.0",

  "description": "PSS Nexus Chat — Windows desktop client",

  "main": "main.js",

  "author": "PSS Nexus",

  "license": "UNLICENSED",

  "private": true,

  "scripts": {

    "start": "electron .",

    "dev": "electron .",

    "prebuild": "node scripts/prepare-icons.js",

    "build": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win",

    "build:portable": "cross-env CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --win portable"

  },

  "dependencies": {

    "electron-updater": "^6.8.9"

  },

  "devDependencies": {

    "cross-env": "^7.0.3",

    "electron": "^34.5.8",

    "electron-builder": "^25.1.8",

    "png-to-ico": "^2.1.8",

    "rcedit": "^4.0.1"

  },

  "build": {

    "appId": "com.pssnexus.chat",

    "productName": "PSS Nexus Chat",

    "directories": {

      "output": "dist"

    },

    "files": [

      "main.js",

      "preload.js",

      "assets/**/*"

    ],

    "afterPack": "scripts/after-pack.js",

    "icon": "assets/icon.ico",

    "win": {

      "target": [

        {

          "target": "nsis",

          "arch": [

            "x64"

          ]

        }

      ],

      "icon": "assets/icon.ico",

      "signAndEditExecutable": false

    },

    "nsis": {

      "oneClick": false,

      "allowToChangeInstallationDirectory": true,

      "createDesktopShortcut": true,

      "createStartMenuShortcut": true,

      "shortcutName": "PSS Nexus Chat",

      "installerIcon": "assets/icon.ico",

      "uninstallerIcon": "assets/icon.ico"

    },

    "portable": {

      "artifactName": "PSS-Nexus-Chat-Portable.exe"

    },

    "publish": [

      {

        "provider": "github",

        "owner": "mubashir-78",

        "repo": "desktop-chat-app"

      }

    ]

  }

}

